# Local act uses Podman (DOCKER_HOST via scripts/run-act.sh / make act), not Docker Engine.
#
# Map GHA runner labels to local images (act skips the job without this).
# Use catthehacker's act image (includes Node) so JS actions like setup-python work;
# plain ubuntu:24.04 fails with: exec: "node": executable file not found in $PATH
-P ubuntu-24.04=catthehacker/ubuntu:act-24.04
